# Configuration de l'application Immo Estimateur
# Copier ce fichier en .env et ajuster les valeurs

# Géoplateforme IGN
GEOCODING_BASE_URL=https://data.geopf.fr/geocodage/search
GEOCODING_TIMEOUT=10

# DVF (Données de Valeur Foncière)
DVF_BASE_URL=https://apidf-preprod.cerema.fr
DVF_TIMEOUT=30

# ADEME DPE
DPE_BASE_URL=https://data.ademe.fr/data-fair/api/v1/datasets/dpe-v2-logements-existants/lines
DPE_TIMEOUT=15

# API Découpage administratif
GEO_API_BASE_URL=https://geo.api.gouv.fr
GEO_API_TIMEOUT=10

# Overpass (OpenStreetMap)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=30

# Cache et persistence
DATABASE_PATH=data/immo_cache.db
MODEL_PATH=data/models/model_latest.pkl

# Paramètres d'estimation
DEFAULT_SEARCH_RADIUS_M=500
MAX_SEARCH_RADIUS_M=2000
COMPARABLE_MONTHS=36
SURFACE_TOLERANCE_PCT=0.30
MIN_COMPARABLES=3
